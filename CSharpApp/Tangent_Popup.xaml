<Window x:Class="CSharpApp.Tangent_Popup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSharpApp"
        mc:Ignorable="d"
        Title="Tangent_Popup" Height="250" Width="120">
    <Grid>
        <TextBlock HorizontalAlignment="Center" Margin="0,28,0,0" TextWrapping="Wrap" Text="Enter X Value:" VerticalAlignment="Top"/>
        <TextBox x:Name="XValue" Margin="0,64,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="81"/>
        <Button Content="Plot Tangent" HorizontalAlignment="Center" Margin="0,136,0,0" VerticalAlignment="Top" Click="Button_Click"/>

    </Grid>

</Window>
