<Window x:Class="CSharpApp.Plot_Popup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSharpApp"
        mc:Ignorable="d"
        Title="Plot_Popup" Height="342" Width="400">
    <Grid>
        <TextBox Name="Start" HorizontalAlignment="Left" Margin="181,45,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="Stop" HorizontalAlignment="Left" Margin="181,123,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="Step" HorizontalAlignment="Left" Margin="181,203,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="44,46,0,0" TextWrapping="Wrap" Text="Enter the starting value" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="44,125,0,0" TextWrapping="Wrap" Text="Enter the ending value" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="40,204,0,0" TextWrapping="Wrap" Text="Enter the precision value" VerticalAlignment="Top" RenderTransformOrigin="0.499,0.567"/>
        <Button Content="Build Graph" HorizontalAlignment="Center" Margin="0,279,0,0" VerticalAlignment="Top" Click="Button_Click" RenderTransformOrigin="0.503,1.353"/>
        <CheckBox Name="Show_Derivative" Content="Show Derivative" HorizontalAlignment="Left" Margin="162,241,0,0" VerticalAlignment="Top" Checked="Show_Derivative_Checked" Unchecked="Show_Derivative_Unchecked"/>


    </Grid>
</Window>
