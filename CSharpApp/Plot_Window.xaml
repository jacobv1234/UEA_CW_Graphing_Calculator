<Window x:Class="CSharpApp.Plot_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSharpApp"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="Plot_Window" Height="500" Width="800">
    <Grid>
        <oxy:PlotView x:Name="PlotView" Height="375" Margin="0,0,0,84"/>
        <Button x:Name="Integral" Content="Calculate Integral" HorizontalAlignment="Left" Margin="36,400,0,0" VerticalAlignment="Top" Click="IntegralClick"/>
        <Button x:Name="Root" Content="Find Root" HorizontalAlignment="Left" Margin="203,400,0,0" VerticalAlignment="Top" Click="Find_Root"/>
        <TextBox x:Name="Output_Plot" HorizontalAlignment="Right" Height="44" Margin="0,393,10,0" TextWrapping="Wrap" Text="Output" VerticalAlignment="Top" Width="272" Style ="{StaticResource ReadOnlyBox}"/>
        <Button x:Name="Tangent" Content="Plot Tangent" HorizontalAlignment="Left" Margin="331,400,0,0" VerticalAlignment="Top" Click="Tangent_Click"/>

    </Grid>
</Window>
