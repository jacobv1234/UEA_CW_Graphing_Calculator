<Window x:Class="CSharpApp.Integral_Popup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSharpApp"
        mc:Ignorable="d"
        Title="Integral_Popup" Height="450" Width="400">
    <Grid>
        <TextBox x:Name="Start_Value" Margin="200,29,80,0" TextWrapping="Wrap" Text="Input Start" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="Stop_Value" HorizontalAlignment="Left" Margin="200,81,0,0" TextWrapping="Wrap" Text="Input Stop" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="86,30,0,0" TextWrapping="Wrap" Text="Start Value:" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="86,82,0,0" TextWrapping="Wrap" Text="Stop Value:" VerticalAlignment="Top"/>
        <Button Content="Calculate Integral" HorizontalAlignment="Center" Margin="0,141,0,0" VerticalAlignment="Top" Click="IntegralCalculate"/>

    </Grid>
</Window>
